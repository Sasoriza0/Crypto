logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test & coverage
coverage
.nyc_output

# Temporary & system files
.DS_Store
Thumbs.db
*.tsbuildinfo
apps/*/*.tsbuildinfo
packages/*/*.tsbuildinfo
.cache
