{
  "name": "shiftcrack",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based cryptography learning game (Caesar, Transposition, Frequency Analysis)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @shiftcrack/web",
    "dev:server": "npm run dev --workspace @shiftcrack/server",
    "build": "npm run build --workspace @shiftcrack/shared && npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
