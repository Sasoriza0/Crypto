# =============================================================================
# ShiftCrack Production Docker Environment Configuration
# Target domain: https://shiftcrack.online
# Location on Linux VM: /opt/shiftcrack/.env
#
# IMPORTANT:
# Generate strong 32-byte random secrets on your machine or VM:
#   openssl rand -base64 32
# =============================================================================

# ---------- Database (PostgreSQL container) ----------
POSTGRES_USER=shiftcrack
POSTGRES_PASSWORD=replace_with_strong_production_db_password
POSTGRES_DB=shiftcrack
DATABASE_URL=postgresql://shiftcrack:replace_with_strong_production_db_password@postgres:5432/shiftcrack?schema=public

# ---------- Backend Server (apps/server) ----------
NODE_ENV=production
SERVER_PORT=4000
CLIENT_ORIGIN=https://shiftcrack.online
# Set to 1 because the app runs behind Nginx reverse proxy
TRUST_PROXY=1

# 256-bit session cookie signing secret
SESSION_SECRET=replace_with_random_32_bytes_session_secret

# Session TTLs (hours/minutes)
SESSION_TTL_HOURS=24
GAME_SESSION_TTL_MINUTES=1440
BCRYPT_COST=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ATTEMPTS_MAX=10
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PASSWORD_RESET_MAX=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# SMTP email service (for password reset letters; prints to server logs if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ShiftCrack Security <noreply@shiftcrack.online>

# ---------- Frontend Web (apps/web) ----------
WEB_PORT=3000
# In production behind Nginx, the frontend and API share the same origin:
NEXT_PUBLIC_API_URL=/api/v1
