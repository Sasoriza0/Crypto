# =============================================================================
# ShiftCrack Docker deployment configuration template
# Copy this file to .env before starting containers:
#   cp .env.docker.example .env
#
# IMPORTANT:
# Replace all placeholder values and passwords with strong random secrets!
# Generate 32-byte random secrets: openssl rand -base64 32
# =============================================================================

# ---------- Database (PostgreSQL container) ----------
POSTGRES_USER=shiftcrack
POSTGRES_PASSWORD=pass
POSTGRES_DB=shiftcrack
DATABASE_URL=postgresql://shiftcrack:pass@postgres:5432/shiftcrack?schema=public

# ---------- Backend Server (apps/server) ----------
NODE_ENV=production
SERVER_PORT=4000
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=1

# 256-bit session cookie signing secret
SESSION_SECRET=secret

# Session TTLs (hours/minutes)
SESSION_TTL_HOURS=24
GAME_SESSION_TTL_MINUTES=1440
BCRYPT_COST=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ATTEMPTS_MAX=10
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PASSWORD_RESET_MAX=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# SMTP email service (for password reset; prints to console if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ShiftCrack Security <noreply@shiftcrack.example.com>

# ---------- Frontend Web (apps/web) ----------
WEB_PORT=3000
# For local Docker Compose testing (accessing backend at localhost:4000):
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# In production when Nginx fronts both web and /api/v1 at the same domain:
# NEXT_PUBLIC_API_URL=/api/v1
