# =============================================================================
# ShiftCrack Local & Production Environment Configuration Template
# =============================================================================

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER=shiftcrack
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=shiftcrack
DATABASE_URL=postgresql://shiftcrack:replace_with_strong_password@localhost:5432/shiftcrack?schema=public

# ---------- Backend Server (apps/server) ----------
NODE_ENV=development
SERVER_PORT=4000
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=1

# 256-bit session cookie signing secret
SESSION_SECRET=replace_with_32_random_bytes_secret

# Session TTLs (hours/minutes)
SESSION_TTL_HOURS=24
GAME_SESSION_TTL_MINUTES=1440
BCRYPT_COST=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ATTEMPTS_MAX=10
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PASSWORD_RESET_MAX=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# SMTP email service
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ShiftCrack Security <noreply@shiftcrack.online>

# ---------- Frontend Web (apps/web) ----------
WEB_PORT=3000
# For local dev:
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# In production with Nginx:
# NEXT_PUBLIC_API_URL=/api/v1
