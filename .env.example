# ============================================================
# ShiftCrack environment configuration — FAKE VALUES ONLY
# Copy to .env locally and replace with real local dev values.
# Real secrets live in GitHub Secrets / server environment,
# NEVER in this file, code, or git history.
# ============================================================

# ---------- Server (apps/server) ----------

# Local PostgreSQL connection string (no Docker).
# Create the database locally: createdb shiftcrack_dev
DATABASE_URL="postgresql://postgres:fake_password@localhost:5432/shiftcrack_dev?schema=public"

# Session cookie signing secret (256-bit+).
# Generate a real one with: openssl rand -base64 32
SESSION_SECRET="fake_session_secret_change_me_to_32_random_bytes"

# Express API port
PORT=4000

# Allowed CORS origin for the Next.js client
CLIENT_ORIGIN="http://localhost:3000"

# Server-side session TTL (hours)
SESSION_TTL_HOURS=24

# Game session TTL (minutes) — brute-force lifecycle window
GAME_SESSION_TTL_MINUTES=30

# Rate limiting: global per-IP window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Node environment
NODE_ENV="development"

# ---------- Web (apps/web) ----------

# Public API base URL consumed by the browser client
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# ---------- CI/CD (placeholders, real values in GitHub Secrets) ----------

VERCEL_TOKEN="fake_vercel_token"
VERCEL_ORG_ID="fake_vercel_org_id"
VERCEL_PROJECT_ID="fake_vercel_project_id"
EC2_HOST="ec2-fake-host.example.com"
EC2_USER="ubuntu"
EC2_SSH_KEY_PATH="~/.ssh/fake_deploy_key"
