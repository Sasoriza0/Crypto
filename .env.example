# ============================================================
# ShiftCrack environment configuration — FAKE VALUES ONLY
# Copy to .env locally and replace with real local dev values.
# Real secrets live in GitHub Secrets / server environment,
# NEVER in this file, code, or git history.
# ============================================================

# ---------- Server (apps/server) ----------

# Local PostgreSQL connection string (no Docker).
# Create the database locally: createdb shiftcrack_dev
DATABASE_URL="postgresql://postgres:fake_password@localhost:5432/shiftcrack_dev?schema=public"

# Session cookie signing secret (256-bit+).
# Generate a real one with: openssl rand -base64 32
SESSION_SECRET="fake_session_secret_change_me_to_32_random_bytes"

# Express API port
PORT=4000

# Allowed CORS origin for the Next.js client
CLIENT_ORIGIN="http://localhost:3000"

# Server-side session TTL (hours). Sliding: the row + cookie are refreshed
# once a session passes half its lifetime, so active players never drop out.
# Hard floor: values below 24 are clamped to 24h in code (heartbeat pings
# every 4 min keep the cookie alive while a player thinks locally).
SESSION_TTL_HOURS=24

# Game session TTL (minutes) — how long an ACTIVE session stays solvable.
# Cryptoanalysis takes time: 24h. Brute-force is throttled by lockouts instead.
# Hard floor: values below 1440 are clamped to 24h in code.
GAME_SESSION_TTL_MINUTES=1440

# Rate limiting: global per-IP window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Rate limiting: stricter per-IP windows for brute-force surfaces
# (attempts align with the per-session lockout: 10 failures -> cooldown)
# NOTE: outside NODE_ENV=production these limits are multiplied by 1000 in
# code so local dev and the smoke script never trip the middleware.
RATE_LIMIT_ATTEMPTS_MAX=10
RATE_LIMIT_AUTH_MAX=10

# bcrypt cost factor for account passwords (4..15, default 12)
BCRYPT_COST=12

# Rate limiting: password reset endpoints (outbound email + token
# brute-force surface) — strictest window of all
RATE_LIMIT_PASSWORD_RESET_MAX=5

# Password reset token lifetime (minutes). Hard floor: values below 5 are
# clamped to 5 minutes in code.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ---------- SMTP (optional in dev) ----------
# With SMTP_HOST absent, password reset letters are printed to the server
# console instead of being sent (local development fallback).
# In production set a real host + credentials via server environment.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ShiftCrack Security <noreply@shiftcrack.example.com>"

# Node environment
NODE_ENV="development"

# ---------- Web (apps/web) ----------

# Public API base URL consumed by the browser client
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# ---------- CI/CD (placeholders, real values in GitHub Secrets) ----------

VERCEL_TOKEN="fake_vercel_token"
VERCEL_ORG_ID="fake_vercel_org_id"
VERCEL_PROJECT_ID="fake_vercel_project_id"
EC2_HOST="ec2-fake-host.example.com"
EC2_USER="ubuntu"
EC2_SSH_KEY_PATH="~/.ssh/fake_deploy_key"
