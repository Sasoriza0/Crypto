// Prisma 7 ships the TS-first `prisma-client` generator which requires an
// explicit output path. Generating into src/generated (instead of the default
// node_modules location) keeps the client visible in git and immune to npm
// workspace hoisting quirks in a monorepo.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CipherModule {
  CAESAR
  TRANSPOSITION
  FREQUENCY
  VIGENERE
  CHIMERA
}

enum SessionStatus {
  ACTIVE
  SOLVED
  FAILED
  EXPIRED
}

model User {
  id                  String               @id @default(cuid())
  email               String?              @unique // null for anonymous users (hybrid auth)
  // Public handle for local accounts (leaderboards). Null for anonymous
  // users; unique among registered players (Postgres allows multiple NULLs).
  nickname            String?              @unique
  passwordHash        String? // bcrypt; accounts only
  provider            String               @default("anonymous") // "anonymous" | "local"
  createdAt           DateTime             @default(now())
  gameSessions        GameSession[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
}

// One-time password reset token (SDD §5, OWASP Forgot Password cheat sheet).
// Only the SHA-256 of the CSPRNG token is stored — a DB leak never reveals
// usable reset links. Rows are single-use: deleted on successful reset and
// replaced whenever the user requests a new token (one active token max).
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime // short TTL enforced at creation + checked at use
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt]) // expiration sweeps
}

// Server-side session store (SDD §8.3 step 4.2, Option A). The id is a
// 256-bit CSPRNG token (32 bytes, base64url) carried in an httpOnly cookie;
// storing it server-side enables logout revocation and id rotation on login.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt]) // expiration sweeps
}

model GameSession {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  module        CipherModule
  difficulty    Difficulty
  language      String // "uk" | "en" — phrase language, tied to the UI locale
  ciphertext    String
  // SHA-256 of the normalized plaintext. The plaintext itself is never
  // persisted, so even a full DB leak reveals no challenge answers.
  plaintextHash String
  cipherParams  Json // shift / permutation key — never exposed via the API
  // Thematic context of the challenge ("Військовий наказ" etc.). Exposed in
  // the session meta on EASY, revealable as a hint on MEDIUM, hidden on HARD.
  contextClue   String?
  // True once the MEDIUM context hint has been spent (keeps crypto hint
  // tiers independent of the context spend).
  contextUsed   Boolean       @default(false)
  status        SessionStatus @default(ACTIVE)
  attempts      Int           @default(0)
  hintsUsed     Int           @default(0)
  lockedUntil   DateTime? // anti-bruteforce cooldown after failed attempts
  startedAt     DateTime      @default(now())
  solvedAt      DateTime?
  expiresAt     DateTime // TTL enforced by app logic

  // userId: "list my sessions" lookup; (status, expiresAt): expiration sweeps
  @@index([userId])
  @@index([status, expiresAt])
  // Leaderboards on pure solve time (SDD Phase 8): rank SOLVED sessions per
  // module, filter by hints used, order by solvedAt.
  @@index([module, status, solvedAt])
  @@index([module, status, hintsUsed, solvedAt])
}
